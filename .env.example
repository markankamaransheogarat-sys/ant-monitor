# Telegram Bot configuration (required for sending alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Position & Alert thresholds
ENTRY_PRICE=106.5
LIQUIDATION_PRICE=77.0
ALERT_LOW_THRESHOLD=85.0
ALERT_HIGH_THRESHOLD=110.0
IPO_REFERENCE_PRICE=83.0

# Symbols & polling schedule
BINANCE_SYMBOL=ANTUSDT
NASDAQ_SYMBOL=ANT
POLL_INTERVAL_SECONDS=300
ALERT_INTERVAL_SECONDS=45
ALERT_COOLDOWN_SECONDS=900
HTTP_TIMEOUT_SECONDS=5.0
NEWS_WINDOW_MINUTES=30
NEWS_MAX_ITEMS=2

# Optional backup spot quote APIs (used if yfinance returns None/error)
FINNHUB_API_KEY=
POLYGON_API_KEY=

# Optional HTTP/SOCKS proxy URL if Telegram or market feeds require proxying
PROXY_URL=

# Logging
LOG_FILE=monitor.log
LOG_LEVEL=INFO
